{
  "name": "signal-news-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "SIGNAL — multi-source live news monitoring desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:installer": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "pack:win": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.17.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "ws": "^8.18.0"
  },
  "productName": "SIGNAL",
  "author": "SIGNAL",
  "license": "UNLICENSED",
  "build": {
    "appId": "app.signal.monitor",
    "productName": "SIGNAL",
    "copyright": "Copyright © 2026 SIGNAL",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "SIGNAL Setup 1.0.0.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SIGNAL",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "SIGNAL Portable 1.0.0.${ext}"
    }
  }
}